rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users: Anyone authenticated can READ profiles (needed for handle resolution + live state).
    // Only the user themselves can WRITE their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- V2 COLLECTIONS ---

    // Folders: Only owner can access
    match /folders/{folderId} {
        allow read, write: if request.auth != null && resource.data.ownerId == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Activities: Only owner can access, OR public read for ACTIVE/DRAFT activities so participants can load them
    match /activities/{activityId} {
        allow read: if request.auth != null && (
            resource.data.ownerId == request.auth.uid || 
            resource.data.status == "DRAFT" ||
            resource.data.status == "ACTIVE" ||
            resource.data.status == "LOCKED"
        );
        allow write: if request.auth != null && resource.data.ownerId == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Responses (Global Collection):
    match /responses/{responseId} {
        // Create: Anyone authenticated (including anonymous) can submit
        allow create: if request.auth != null; 
        
        // Read: Anyone authenticated can read (MVP — tighten later)
        allow read: if request.auth != null;

        // Update: Only the original author can update their response
        allow update: if request.auth != null && (
            resource.data.participantId == request.auth.uid
        );
    }
    
    // --- V1 LEGACY ---
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null;
      
      // Allow read/write to sub-collections (responses, etc.) 
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Teams: Members can read, owner can write
    match /teams/{teamId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null;
    }
  }
}
